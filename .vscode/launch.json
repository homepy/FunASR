        {
            "name": "FunASR WebSocket Client-File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runtime/python/websocket/funasr_wss_client.py",
            "args": [
                "--host", "localhost",
                "--port", "10095",
                "--audio_in", "${workspaceFolder}/runtime/funasr_api/asr_example.wav",
                "--audio_fs", "8000",
                "--chunk_size", "5, 10, 5",
                "--chunk_interval", "10",
                "--mode", "online",
                "--ssl", "0",
                "--use_itn", "1"
            ],
            "console": "integratedTerminal",
            "python": "/opt/miniconda3/envs/py39/bin/python",
            "justMyCode": false
        },
        {
            "name": "FunASR WebSocket Client-Mic",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runtime/python/websocket/funasr_wss_client.py",
            "args": [
                "--host", "localhost",
                "--port", "10095",
                "--chunk_size", "5, 10, 5",
                "--chunk_interval", "10",
                "--mode", "2pass",
                "--ssl", "0",
                "--use_itn", "1"
            ],
            "console": "integratedTerminal",
            "python": "/opt/miniconda3/envs/py39/bin/python",
            "justMyCode": false
        },
        {
            "name": "funasr-wss-server-2pass:16k",

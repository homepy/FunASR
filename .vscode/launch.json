            "request": "launch",
            "program": "${workspaceFolder}/runtime/websocket/build/bin/funasr-wss-server-2pass",
            "args": [
                "--download-model-dir", "${workspaceFolder}/models",
                "--model-dir", "damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-onnx",
                "--offline-model-revision", "v2.0.5",
                "--online-model-dir", "damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online-onnx",
                "--online-model-revision", "v2.0.5",
                "--vad-dir", "damo/speech_fsmn_vad_zh-cn-16k-common-onnx",
                "--vad-revision", "v2.0.4",
                "--punc-dir", "damo/punc_ct-transformer_zh-cn-common-vad_realtime-vocab272727-onnx",
                "--punc-revision", "v2.0.5",
                "--itn-dir", "thuduj12/fst_itn_zh",
                "--itn-revision", "v1.0.1",
                "--lm-dir", "damo/speech_ngram_lm_zh-cn-ai-wesp-fst",
                "--lm-revision", "v1.0.2",
                "--hotword", "",
                "--listen-ip", "0.0.0.0",
                "--port", "10095",
                "--io-thread-num", "2",
                "--decoder-thread-num", "8",
                "--model-thread-num", "2",
                "--quantize", "true"
            ],
            "cwd": "${workspaceFolder}/runtime/websocket/bin",
            "MIMode": "lldb",
            "environment": [
                {
                    "name": "PATH",
                    "value": "/opt/miniconda3/envs/py39/bin:${env:PATH}"
                }
            ]
        },

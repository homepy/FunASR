    "version": "0.2.0",
    "configurations": [
        {
            "name": "FunASR WebSocket Server:8k",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runtime/python/websocket/funasr_wss_server.py",
            "args": [
                "--host", "0.0.0.0",
                "--port", "10095",
                "--asr_model", "iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch",
                "--asr_model_revision", "v2.0.4",
                "--asr_model_online", "iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online",
                "--asr_model_online_revision", "v2.0.4",
                "--vad_model", "iic/speech_fsmn_vad_zh-cn-8k-common",
                "--vad_model_revision", "v2.0.4",
                "--punc_model", "iic/punc_ct-transformer_zh-cn-common-vad_realtime-vocab272727",
                "--punc_model_revision", "v2.0.4",
                "--ngpu", "0",
                "--device", "cpu",
                "--ncpu", "4"
            ],
            "console": "integratedTerminal",
            "python": "/opt/miniconda3/envs/py39/bin/python",
            "justMyCode": false
        },
        {
            "name": "FunASR WebSocket Server:16k",
            "type": "debugpy",

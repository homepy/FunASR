{
  "version": 4,
  "configurePresets": [
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install",
      "cacheVariables": {
        "ONNXRUNTIME_DIR": "/usr/local/opt/onnxruntime",
        "FFMPEG_DIR": "/usr/local/opt/ffmpeg",
        "OPENSSL_ROOT_DIR": "/usr/local/opt/openssl@3"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "description": "针对 macOS 的 Release 构建，使用 Homebrew 库 (硬编码路径)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "description": "针对 macOS 的 Debug 构建，使用 Homebrew 库 (硬编码路径)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ONNXRUNTIME_DIR": "/usr/local",
        "FFMPEG_DIR": "/usr/local",
        "OPENSSL_ROOT_DIR": "/usr/local/ssl"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "针对 Linux 的 Release 构建",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-release",
      "installDir": "${sourceDir}/install/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "针对 Linux 的 Debug 构建",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}